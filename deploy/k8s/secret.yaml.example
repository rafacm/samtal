# The secrets the serving pod reads, as a template that is deliberately
# not applicable.
#
# The `.example` suffix is load bearing rather than a convention. A
# `.yaml` here would ride along on `kubectl apply -f deploy/k8s/`, and
# every value below is a nonempty string that satisfies every presence
# check the server makes, so the deployment would come up protected by
# strings that are printed in this repository. Nothing under
# `deploy/k8s/*.yaml` is a Secret, and the agreement test asserts that.
#
# The straight way to make the real one, with no file to leave behind:
#
#     kubectl create secret generic vinga \
#       --from-literal=VINGA_AUTH_SECRET="$(openssl rand -hex 32)" \
#       --from-literal=VINGA_API_SECRET="$(openssl rand -hex 32)" \
#       --from-literal=VINGA_DB_PASSWORD="$THE_DATABASE_PASSWORD"
#
# Or fill this in, apply it by explicit path and do not commit it.
# Either way the values belong wherever this deployment already keeps
# secrets, which is the same place a restore would need them from.
apiVersion: v1
kind: Secret
metadata:
  name: vinga
  labels:
    app.kubernetes.io/name: vinga
type: Opaque
stringData:
  # Signs the device tokens the OTA endpoint issues and the WebSocket
  # verifies. Required whenever device authentication is on, which is
  # the default. `openssl rand -hex 32`.
  VINGA_AUTH_SECRET: REPLACE-ME-with-openssl-rand-hex-32
  # The bearer token the configuration API is gated on. The API is
  # always mounted and always gated, so a server started without this
  # does not come up at all. `openssl rand -hex 32`.
  VINGA_API_SECRET: REPLACE-ME-with-openssl-rand-hex-32
  # The password of the role in deployment.yaml's VINGA_DB_USER. The
  # server ships a development default of `vinga` for an instance bound
  # to loopback and nothing else; set a real one before anything
  # reachable runs on it.
  VINGA_DB_PASSWORD: REPLACE-ME-with-the-database-password
  # The optional third, needed only once a credential is stored
  # encrypted rather than named as an environment reference. A
  # deployment whose provider keys are all environment references never
  # needs one; once ciphertext exists, losing this key means losing
  # those credentials, so it is escrowed with the deployment's other
  # secrets and separately from the backups.
  #
  #     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
  #
  # It holds a comma-separated list, newest first, so a rotation adds a
  # key and retires none.
  #
  # VINGA_MASTER_KEY: REPLACE-ME-with-a-generated-fernet-key
