# Reference clones of upstream projects (see README)
vendor/

# Python
.venv/
__pycache__/
*.pyc

# Model weights (downloaded at deploy time)
models/
*.pt

# Instance-specific configuration stays out of the repository
*.local.yaml
# Anything a local run writes beside the code names itself `.local`, and
# a memory directory left over from a manual checkpoint has already been
# committed once this way.
*.local
# The server reads .env itself (main.py calls load_dotenv), so these are
# the secrets and nothing else needs to know about them.
.env
.env.local

# Correspondence with the infrastructure side, which is a private
# repository. These carry hostnames, device identifiers and deployment
# detail that must not land in a public one, and they arrive in the
# working tree as ordinary files, one `git add -A` away from being
# committed.
*deploy-brief*.md

# Per-developer tooling. Nothing here is needed to run or test the
# server: `uv sync` and `uv run` are the whole story, and a contributor
# should not have to adopt somebody else's tools to work on this.
mise.toml
.mcp.json
.claude/worktrees/
.claude/settings.local.json

# ESP-IDF build artifacts
build/
sdkconfig.old
dependencies.lock
managed_components/

# Logs and OS noise
*.log
nohup.out
.DS_Store
